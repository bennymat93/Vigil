#include <windows.h>
#include "resource.h"

// ---- Icons (active = keeping awake, paused = off) ----
IDI_ACTIVE  ICON  "../assets/vigil_active.ico"
IDI_PAUSED  ICON  "../assets/vigil_paused.ico"

// ---- Application manifest ----
// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST (canonical raw form,
// accepted by both MS rc.exe and windres without relying on the macro).
1 24 "vigil.manifest"

// ---- Embedded user guide (extracted to %TEMP% and opened on demand) ----
IDR_GUIDE_HTML   RCDATA "../docs/guide.html"
IDR_GUIDE_ACTIVE RCDATA "../assets/vigil_active_256.png"
IDR_GUIDE_PAUSED RCDATA "../assets/vigil_paused_256.png"

// ---- Version information ----
#define VER_FILE     1,1,1,0
#define VER_FILE_STR "1.1.1.0"
#define VER_PROD     1,1,1,0
#define VER_PROD_STR "1.1.1"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILE
 PRODUCTVERSION VER_PROD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vigil"
            VALUE "FileDescription",  "Vigil - keeps your PC awake"
            VALUE "FileVersion",      VER_FILE_STR
            VALUE "InternalName",     "Vigil"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "Vigil.exe"
            VALUE "ProductName",      "Vigil"
            VALUE "ProductVersion",   VER_PROD_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
